{
  "name": "cupboard",
  "version": "1.0.2",
  "description": "Plan meals, scale recipes and build grocery lists from your notes.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --import ./tests/harness/register.mjs --test \"tests/**/*.test.ts\"",
    "build": "npm run test && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "build:deploy": "npm run build && node scripts/deploy.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "release": "node scripts/release.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "meal-planning",
    "recipes",
    "grocery-list",
    "pantry"
  ],
  "author": "Jeroen van der Wal",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "tslib": "^2.8.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.68.0",
    "yaml": "^2.9.1"
  }
}
