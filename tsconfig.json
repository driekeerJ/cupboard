{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2020",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "strict": true,

    // Toegevoegd in stap 0c. Alle vier gaven samen vier fouten, allemaal
    // meteen opgelost. noUncheckedIndexedAccess staat bewust niet hier maar
    // in tsconfig.strict.json: die geeft er nog vijftig.
    "noImplicitReturns": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "lib": ["DOM", "ES2020"]
  },
  "include": ["src/**/*.ts"]
}
